# ---- AI stylist ----
# The stylist runs on EITHER a local model or Claude. Pick one in the app
# (Stylist page); the choice is stored server-side. Neither is required for the
# rest of the app to work.

# Local model over an OpenAI-compatible endpoint (LM Studio :1234, Ollama :11434).
# Must be a VISION-capable model — garments are described from their images.
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=qwen/qwen3.6-35b-a3b

# Claude (server-side only — never expose this to the client).
# ANTHROPIC_API_KEY=sk-ant-...

# Which backend to use before the user picks one: anthropic | local
# AI_PROVIDER=local
